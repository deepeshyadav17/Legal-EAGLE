# ============================================================================
# Legal Eagle — Environment Configuration (.env.example)
# Copy to .env for local development. Never commit real secrets to Git.
# ============================================================================

# Server & Environment
APP_ENV=development
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Kolkata

# PostgreSQL Connection (No Redis or Docker required)
DATABASE_URL=postgresql://postgres:<YOUR_DATABASE_PASSWORD>@db.enwakmwqzfttovzxxziq.supabase.co:5432/postgres?sslmode=require
DB_MAX_CONNS=20
DB_MIN_CONNS=2
AUTO_MIGRATE=true
AUTO_SEED=true

# Authentication & Security (Replace placeholders in production)
JWT_ACCESS_SECRET=replace-with-32-byte-minimum-random-secret-key-for-dev
JWT_ACCESS_TTL_MINUTES=15
REFRESH_SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Rate Limiting (In-Process Token Bucket)
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Booking & SLA Windows
BOOKING_HOLD_MINUTES=10
LAWYER_RESPONSE_HOURS=12
CLIENT_RESCHEDULE_HOURS=12

# Payment Provider ("MOCK" for local development, "RAZORPAY" for production)
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=rzp_test_placeholder_only
RAZORPAY_KEY_SECRET=rzp_secret_placeholder_only
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder_only

# Background Worker (Set EMBED_WORKER=true to run worker inside API process locally)
EMBED_WORKER=true
WORKER_POLL_INTERVAL_SECONDS=5

# Frontend Vite Configuration (for React API Adapter)
VITE_DEMO_MODE=true
VITE_API_BASE_URL=http://localhost:8080/api/v1

